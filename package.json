{
  "name": "leadscrapper",
  "version": "1.0.0",
  "description": "LeadScrapper – Find businesses without websites for outreach",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "clean:port": "powershell -Command \"Get-Process -Id (Get-NetTCPConnection -LocalPort 4000 -ErrorAction SilentlyContinue).OwningProcess -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "pdfkit": "^0.13.0",
    "puppeteer-core": "^25.16.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
